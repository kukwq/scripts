local function getQuestTouchPart(npc)
    if Config.QuestTouchPart ~= "" then
        local p = npc:FindFirstChild(Config.QuestTouchPart, true)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(npc:GetDescendants()) do
        if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter") then
            return d
        end
    end
    return npcRootPart(npc)

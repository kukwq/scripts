local function sendClickAt(x, y)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

local function isHubInteracting()
    if UserInputService:GetFocusedTextBox() then return true end
    local main = Runtime.MainFrame
    if not main or not main.Visible then return false end
    local pos  = UserInputService:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local mx, my = pos.X - inset.X, pos.Y - inset.Y
    local ap, as = main.AbsolutePosition, main.AbsoluteSize
    return mx >= ap.X and mx <= ap.X + as.X and my >= ap.Y and my <= ap.Y + as.Y
end

local function simulateClick()
    if isHubInteracting() then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local vp = camera.ViewportSize
    sendClickAt(math.floor(vp.X / 2), math.floor(vp.Y / 2))
end

local function callRemote(remote, ...)
    if remote:IsA("RemoteFunction") then
        return remote:InvokeServer(...)
    end
    remote:FireServer(...)
end

local function callRemoteTimeout(remote, timeout, ...)
    local args = table.pack(...)
    local done, ok, err, res = false, false, nil, nil
    task.spawn(function()
        ok, err = pcall(function()
            res = callRemote(remote, table.unpack(args, 1, args.n))
        end)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < timeout do
        if hasActiveQuest() then return true, "Yes" end
        task.wait(POLL)
    end
    if not done then return false, "timeout" end
    if hasActiveQuest() then return true, res end
    return ok, res or err
end

local function buildAttackCFrame(entry)
    local _, _, root = getCharacterParts()
    if not root or not entry or not entry.hrp then return nil end
    local npcPos = entry.hrp.Position
    local dir    = npcPos - root.Position
    if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
    local unitDir = dir.Unit
    local hitPos  = npcPos + unitDir * Config.AttackOffset
    return CFrame.lookAt(hitPos, hitPos + unitDir)
end

spawnLoop("attack", function()
    if not State.Enabled or not Config.AutoAttack or State.QuestBusy then return end
    local t = State.Target
    if not isTargetAlive(t) then return end
    local _, _, root = getCharacterParts()
    if not root then return end
    if (t.hrp.Position - root.Position).Magnitude > Config.AttackMaxDistance then return end

    if Config.UseRemote then
        local cf = buildAttackCFrame(t)
        if cf then
            if CombatEvent:IsA("RemoteEvent") then

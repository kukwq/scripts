local function findQuestNPC()
    local _, _, root = getCharacterParts()
    local best, bestDist = nil, math.huge
    for _, npc in ipairs(NPCS:GetChildren()) do
        local head  = npc:FindFirstChild("Head")
        local qmark = head and head:FindFirstChild("QMark")
        if qmark and qmark:IsA("BillboardGui") and qmark.AlwaysOnTop then
            local d = (root and head:IsA("BasePart")) and (head.Position - root.Position).Magnitude or 0
            if d < bestDist then best, bestDist = npc, d end
        end
    end
    return best
end


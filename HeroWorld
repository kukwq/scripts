local Dodge = {
    TargetModel  = nil,
    ActiveTracks = {},
    WasDodging   = false,
    Returning    = false,
    Conns        = {},
}

clearDodgeWatch = function()
    for _, c in ipairs(Dodge.Conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(Dodge.Conns)
    table.clear(Dodge.ActiveTracks)
    Dodge.TargetModel = nil
    Dodge.WasDodging   = false
    Dodge.Returning   = false
end

local function watchDodgeTarget(entry)
    local model = entry and entry.model or nil
    if Dodge.TargetModel == model then return end
    clearDodgeWatch()
    if not model or not entry.hum then return end

    Dodge.TargetModel = model
    local anim = entry.hum:FindFirstChildOfClass("Animator")
    if not anim then return end

    table.insert(Dodge.Conns, anim.AnimationPlayed:Connect(function(track)
        local rawId  = track.Animation and track.Animation.AnimationId or ""
        local animId = rawId:match("%d+")
        if not animId or IGNORED_DODGE_ANIMS[animId] then return end

        Dodge.ActiveTracks[track] = true
        Dodge.Returning = false

        local conn
        conn = track.Stopped:Connect(function()
            conn:Disconnect()
            Dodge.ActiveTracks[track] = nil
            if next(Dodge.ActiveTracks) == nil then
                Dodge.Returning = true
            end
        end)
        table.insert(Dodge.Conns, conn)
    end))
end

keep(RunService.Heartbeat:Connect(guarded("farm", function(dt)
    if not State.Enabled or State.QuestBusy then return end
    dt = math.min(dt, 0.1)

    local _, _, root = getCharacterParts()
    if not root then
        State.Target = nil
        State.NeedNoclip = false
        Hooks.Status("Aguardando personagem...")
        return
    end

    local t = State.Target
    if not isTargetAlive(t) then
        -- Se o alvo ainda não estava spawnado quando a quest foi adotada, re-resolve o nome em Living
        if Config.AutoQuest and State.AdoptedFor and State.AdoptedFor ~= "(desconhecido)" then
            local resolved = resolveLivingName(State.AdoptedFor)
            if resolved and resolved ~= Config.NPCName then
                Config.NPCName = resolved
                Hooks.NPCName(resolved)
                markDirty()
            end
        end

        t = pickNextTarget()
        if t then
            State.Target      = t
            State.TargetSince = os.clock()
            State.EmptySince  = nil
        else
            State.Target = nil
            State.NeedNoclip = false
            local now = os.clock()
            State.EmptySince = State.EmptySince or now
            if isRaidFarmActive() then
                Hooks.Status("Aguardando onda da raid...")
            elseif Config.AutoQuest and hasActiveQuest() then
                Hooks.Status("Aguardando respawn (quest ativa)...")
            elseif now - State.EmptySince >= Config.RespawnWait then
                stopFarm("no-npcs", true)
            else
                Hooks.Status("Aguardando respawn...")
            end
            return
        end
    end

    if Config.TargetTimeout > 0 and os.clock() - State.TargetSince > Config.TargetTimeout then
        Skipped[t.model] = os.clock() + 20
        State.Target = nil
        Hooks.Notify("Alvo travado, pulando: " .. t.model.Name)
        return
    end

    local dodging = false
    if Config.AutoDodge then
        watchDodgeTarget(t)
        for track in pairs(Dodge.ActiveTracks) do
            if not track.IsPlaying then
                Dodge.ActiveTracks[track] = nil
            end
        end
        dodging = next(Dodge.ActiveTracks) ~= nil
        if Dodge.WasDodging and not dodging then
            Dodge.Returning = true
        end
        Dodge.WasDodging = dodging
    elseif Dodge.TargetModel ~= nil then
        clearDodgeWatch()
    end

    local effectiveDist = Config.Distance + (dodging and Config.DodgeDistance or 0)
    local goal = computeTargetCFrame(t.hrp, Config.Mode, effectiveDist)
    local dist = (goal.Position - root.Position).Magnitude
    State.NeedNoclip = Config.Noclip or Config.Mode == "Baixo" or dist > 15 or dodging or Dodge.Returning

    if dodging or Dodge.Returning then
        local dodgeSpeed = Config.TravelSpeed * Config.DodgeSpeedMult
        stepToward(root, goal, dt, dodgeSpeed, 0.5)
        if Dodge.Returning and dist <= 1.0 then
            Dodge.Returning = false
        end
    else
        stepToward(root, goal, dt)
    end

    Hooks.Status((dodging and "Desviando: " or "Farmando: ") .. t.model.Name)
end)))


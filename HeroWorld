local function cleanup()
    if dirtyAt then
        dirtyAt = nil
        pcall(saveConfig, true)
    end
    genv.__AutoFarmHub_Capture = nil
    Runtime.Alive = false
    State.Enabled = false
    State.NeedNoclip = false
    for p in pairs(noclipTouched) do
        if p.Parent then p.CanCollide = true end
    end
    table.clear(noclipTouched)
    for _, c in ipairs(Runtime.Conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(Runtime.Conns)
    if clearDodgeWatch then pcall(clearDodgeWatch) end
    if Runtime.Gui then
        pcall(function() Runtime.Gui:Destroy() end)
    end
    if genv.__AutoFarmHub_Cleanup == cleanup then
        genv.__AutoFarmHub_Cleanup = nil
    end
end

local function installQuestRemoteSpy()
    if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
        return false
    end
    local oldNamecall
    local function hook(self, ...)
        local method = getnamecallmethod()
        if self == GetQuestEvent and (method == "InvokeServer" or method == "FireServer") then
            local cap = genv.__AutoFarmHub_Capture
            if cap and not (typeof(checkcaller) == "function" and checkcaller()) then
                task.defer(cap, (...))
            end
        end
        return oldNamecall(self, ...)
    end
    local wrapped = typeof(newcclosure) == "function" and newcclosure(hook) or hook
    local ok = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", wrapped)
    end)
    return ok and oldNamecall ~= nil
end


local function loadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return false end
    local ok, data = pcall(function()
        if not isfile(CONFIG_FILE) then return nil end
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(data) ~= "table" then return false end

    for _, k in ipairs(SAVE_KEYS) do
        if data[k] ~= nil and type(data[k]) == type(Config[k]) then
            Config[k] = data[k]
        end
    end
    if type(data.NPCName) == "string" and data.NPCName ~= "" then
        Config.NPCName = data.NPCName
    end
    if type(data.QuestMap) == "table" then
        for k, v in pairs(data.QuestMap) do
            if type(k) == "string" and type(v) == "string" then
                Config.QuestMap[k] = v
            end
        end
    end
    if type(data.QuestStand) == "table" then
        for k, v in pairs(data.QuestStand) do
            if type(k) == "string" and type(v) == "table"
                and type(v[1]) == "number" and type(v[2]) == "number" and type(v[3]) == "number"
                and v[1] == v[1] and v[2] == v[2] and v[3] == v[3] then
                Config.QuestStand[k] = {v[1], v[2], v[3]}
            end
        end
    end
    if not VALID_MODES[Config.Mode] then
        Config.Mode = "Atrás"
    end
    return true
end

local function saveConfig(silent)
    if typeof(writefile) ~= "function" then
        if not silent then Hooks.Notify("Este executor não expõe writefile.") end
        return false
    end
    local data = {
        NPCName    = Config.NPCName,
        QuestMap   = Config.QuestMap,
        QuestStand = Config.QuestStand,
    }
    for _, k in ipairs(SAVE_KEYS) do
        data[k] = Config[k]
    end
    local ok, err = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    if not silent then
        Hooks.Notify(ok and ("Config salva em " .. CONFIG_FILE) or ("Falha ao salvar: " .. tostring(err)))
    elseif not ok then
        warn("[AutoFarmHub] falha no autosave: " .. tostring(err))
    end
    return ok
end


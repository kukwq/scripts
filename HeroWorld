local function waitFor(parent, name)
    local inst = parent:WaitForChild(name, 10)
    if not inst then
        error(("[AutoFarmHub] '%s' não encontrado em %s (jogo/build diferente?)"):format(name, parent:GetFullName()), 0)
    end
    return inst
end


local function queueAutoRaidReexec()
    local q = getQueueOnTeleport()
    if typeof(q) ~= "function" then return false end
    local loader = [[
        task.wait(2)
        if typeof(isfile) == "function" and typeof(readfile) == "function" then
            if isfile("AutoFarmHub.lua") then
                loadstring(readfile("AutoFarmHub.lua"))()
            elseif isfile("AutoFarmHub/AutoFarmHub.lua") then
                loadstring(readfile("AutoFarmHub/AutoFarmHub.lua"))()
            end
        end
    ]]
    pcall(q, loader)
    return true
end


local function guarded(name, fn)
    local lastErr
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok and err ~= lastErr then
            lastErr = err
            warn(("[AutoFarmHub] erro em %s: %s"):format(name, tostring(err)))
        end
    end
end

local function spawnLoop(name, fn, interval)
    local safe = guarded(name, fn)
    task.spawn(function()
        while Runtime.Alive do
            safe()
            local w = type(interval) == "function" and interval() or interval
            task.wait(w)
        end
    end)
end


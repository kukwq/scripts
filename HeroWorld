            Size = UDim2.fromOffset(18, 34), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.Sub,
            Text = "▼",
        }, head)

        local list = new("ScrollingFrame", {
            LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
            ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, holder)
        round(list, 6)
        new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, list)
        pad(list, 4, 4, 4, 4)

        local selected = initial
        local function renderHead() label.Text = text .. ": " .. (selected or "—") end
        renderHead()

        local function close() list.Visible = false; arrow.Text = "▼" end

        local function rebuild()
            for _, c in ipairs(list:GetChildren()) do
                if c:IsA("GuiObject") then c:Destroy() end
            end
            local opts = getOptions()
            if #opts == 0 then
                new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "Nenhum NPC encontrado em Living",
                    Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Sub,
                }, list)
            end
            for i, opt in ipairs(opts) do
                local b = new("TextButton", {
                    LayoutOrder = i, Size = UDim2.new(1, -6, 0, 26),
                    BackgroundColor3 = (opt.value == selected) and Theme.Accent or Theme.Item,
                    BorderSizePixel = 0, AutoButtonColor = true, Text = opt.text,
                    Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text,
                }, list)
                round(b, 4)
                b.MouseButton1Click:Connect(function()
                    selected = opt.value
                    renderHead()
                    close()
                    onSelect(opt.value)
                    markDirty()
                end)
            end
            list.Size = UDim2.new(1, 0, 0, math.clamp(math.max(#opts, 1) * 28 + 8, 36, 160))
        end

        head.MouseButton1Click:Connect(function()
            if list.Visible then close()
            else rebuild(); list.Visible = true; arrow.Text = "▲" end
        end)

        return {setSelected = function(v) selected = v; renderHead() end}
    end


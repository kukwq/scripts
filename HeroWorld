local function doDialogue(npc)
    local t0             = os.clock()
    local lastInteract   = 0
    local clickedOption1 = false

    while Runtime.Alive and os.clock() - t0 < DIALOGUE_TIMEOUT do
        if hasActiveQuest() then
            return true
        end

        local opt1 = hudGet(HUD.ChatOption1)
        if opt1 and opt1:IsA("GuiButton") and isGuiShown(opt1) then
            clickedOption1 = true
            clickGuiRect(opt1)
            task.wait(POLL)
            continue
        end

        local chat = hudGet(HUD.Chat)
        if chat and chat:IsA("GuiObject") and isGuiShown(chat) then
            clickGuiRect(chat)
        else
            if clickedOption1 then
                return true
            end
            if os.clock() - lastInteract >= 0.3 then
                lastInteract = os.clock()
                interactWithNPC(npc)
            end
        end

        task.wait(POLL)
    end

    return hasActiveQuest()
end

local function waitQuest(timeout)
    local t0 = os.clock()
    while Runtime.Alive and os.clock() - t0 < timeout do
        if hasActiveQuest() then return true end
        task.wait(POLL)
    end
    return hasActiveQuest()
end

local function waitEnemyName(timeout)
    local t0   = os.clock()
    local name = getQuestEnemyName()
    while Runtime.Alive and not name and os.clock() - t0 < timeout do
        task.wait(POLL)
        name = getQuestEnemyName()
    end
    return name
end

local function adoptActiveQuest(originCF)
    local parsed = waitEnemyName(3)
    local resolved
    if parsed then
        resolved = resolveLivingName(parsed) or parsed
        State.AdoptedFor = parsed
        if Config.NPCName ~= resolved then
            Config.NPCName = resolved
            Hooks.NPCName(resolved)
            markDirty()
        end
        Hooks.Notify("Quest ativa! Alvo: " .. resolved)
    else
        State.AdoptedFor = "(desconhecido)"
        Hooks.Notify("Quest ativa, mas não consegui ler o nome do inimigo. Farm ligado mesmo assim.")
    end

    if State.Enabled then
        State.Target     = nil
        State.EmptySince = nil
    else
        local ok = startFarm(originCF)
        if not ok and not parsed then
            return false, "não consegui ler o inimigo nem ligar o farm"
        end
    end
    return true
end

local function tryGetQuest()
    if hasActiveQuest() then return false, nil end
    local npc = findQuestNPC()
    if not npc then return false, nil end
    local _, _, root = getCharacterParts()
    if not root then return false, "personagem indisponível" end

    local originCF = root.CFrame
    State.QuestBusy = true
    local ok, result, reason = pcall(function()
        State.NeedNoclip = false
        local arrived, why = approachQuestNPC(npc)
        if not arrived then return false, why end
        task.wait(POLL)

        local arg = questArgFor(npc.Name)
        local got = false

        if arg and Config.PreferRemote then
            Hooks.Status(("Pegando quest via remote (%s)..."):format(arg))
            local callOk, res = callRemoteTimeout(GetQuestEvent, 5, arg)
            if callOk and hasActiveQuest() then
                got = true
            elseif not callOk then
                Hooks.Notify("Remote falhou: " .. tostring(res) .. " — usando diálogo.")
            else
                got = waitQuest(2)
            end
        end

        if not got and Config.QuestUseDialogue then
            Hooks.Status("Pegando quest pelo diálogo...")
            doDialogue(npc)
            got = waitQuest(3)
        end

        if not got and arg then
            Hooks.Status("Tentando remote novamente (último recurso)...")
            callRemoteTimeout(GetQuestEvent, 3, arg)
            got = waitQuest(2)
        end

        if not got then
            if arg then
                return false, "não consegui pegar a quest (remote e diálogo falharam)"
            end
            return false, ("argumento do GetQuest desconhecido para %s e o diálogo não funcionou"):format(npc.Name)
        end
        return adoptActiveQuest(originCF)
    end)
    State.QuestBusy = false

    if not ok then return false, tostring(result) end
    return result, reason
end

spawnLoop("autoquest", function()
    if not Config.AutoQuest or State.QuestBusy then return end

    if hasActiveQuest() then
        State.QuestFails = 0
        local parsed = getQuestEnemyName()
        if State.AdoptedFor == nil or (parsed and State.AdoptedFor ~= parsed) then
            if parsed then
                adoptActiveQuest()
            elseif State.AdoptedFor == nil then
                task.wait(0.5)
                if hasActiveQuest() and State.AdoptedFor == nil then
                    adoptActiveQuest()
                end
            end
        end
        return
    end

    State.AdoptedFor = nil
    local ok, reason = tryGetQuest()
    if ok then
        State.QuestFails = 0
    elseif reason then
        State.QuestFails += 1
        Hooks.Status("AutoQuest: " .. reason)
        if State.QuestFails >= 3 then
            State.QuestFails = 0
            Config.AutoQuest = false
            markDirty()
            Hooks.QuestToggle(false)
            Hooks.Notify("Auto Quest desligado após 3 falhas (" .. reason .. ").")
        else
            task.wait(Config.AutoQuestCooldown)
        end
    end
end, POLL)


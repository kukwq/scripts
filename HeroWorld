local function getCharacterParts()
    local char = LP.Character
    if not char then return nil end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return nil end
    return char, hum, root
end

local function isRaidFarmActive()
    return Config.AutoRaid and game.PlaceId ~= NORMAL_PLACE_ID
end

local function makeEntry(m)
    if not m:IsA("Model") or Players:GetPlayerFromCharacter(m) then return nil end
    if not isRaidFarmActive() and m.Name ~= Config.NPCName then return nil end
    local hum = m:FindFirstChildOfClass("Humanoid")
    local hrp = m:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
        return {model = m, hum = hum, hrp = hrp}
    end
    return nil
end

local function getGroupNPCs()
    local list = {}
    if not isRaidFarmActive() and not Config.NPCName then return list end
    for _, m in ipairs(LIVING:GetChildren()) do
        local e = makeEntry(m)
        if e then table.insert(list, e) end
    end
    return list
end

local function listNPCNames()
    local counts, names = {}, {}
    for _, m in ipairs(LIVING:GetChildren()) do
        if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and m:FindFirstChild("HumanoidRootPart") then
                if not counts[m.Name] then
                    counts[m.Name] = 0
                    table.insert(names, m.Name)
                end
                counts[m.Name] += 1
            end
        end
    end
    table.sort(names)
    local out = {}
    for _, n in ipairs(names) do
        table.insert(out, {name = n, count = counts[n]})
    end
    return out
end

local function resolveLivingName(parsed)
    if not parsed or parsed == "" then return nil end
    local names = listNPCNames()
    local lower = parsed:lower()
    local function try(pred)
        for _, n in ipairs(names) do
            if pred(n.name:lower()) then return n.name end
        end
        return nil
    end
    return try(function(n) return n == lower end)
        or try(function(n) return n .. "s" == lower or n .. "es" == lower or lower .. "s" == n end)
        or try(function(n) return n:find(lower, 1, true) ~= nil or lower:find(n, 1, true) ~= nil end)
        or parsed
end

local function isTargetAlive(t)
    return t ~= nil
        and t.model ~= nil and t.model.Parent ~= nil
        and t.hum ~= nil and t.hum.Parent ~= nil
        and t.hrp ~= nil and t.hrp.Parent ~= nil
        and t.hum.Health > 0
        and t.hum:GetState() ~= Enum.HumanoidStateType.Dead
end

local function pickNextTarget()
    local _, _, root = getCharacterParts()
    if not root then return nil end
    local best, bestDist = nil, math.huge
    local now = os.clock()
    for _, e in ipairs(getGroupNPCs()) do
        local exp = Skipped[e.model]
        if not exp or exp < now then
            local d = (e.hrp.Position - root.Position).Magnitude
            if d < bestDist then
                best, bestDist = e, d
            end
        end
    end
    return best
end

local function computeTargetCFrame(npcHRP, mode, dist)
    local npcCF  = npcHRP.CFrame
    local npcPos = npcCF.Position
    local _, yaw = npcCF:ToOrientation()
    local yawCF  = CFrame.Angles(0, yaw, 0)
    if mode == "Cima" then
        return CFrame.new(npcPos + Vector3.new(0, dist, 0)) * yawCF * CFrame.Angles(-math.pi / 2, 0, 0)
    elseif mode == "Baixo" then
        return CFrame.new(npcPos + Vector3.new(0, -dist, 0)) * yawCF * CFrame.Angles(math.pi / 2, 0, 0)
    end
    local behind = npcCF * CFrame.new(0, 0, dist)
    return CFrame.lookAt(behind.Position, npcPos + Vector3.new(0, 1.5, 0))
end

local function stepToward(root, goal, dt, speed, snap)
    local cur     = root.Position
    local delta   = goal.Position - cur
    local dist    = delta.Magnitude
    local maxStep = (speed or Config.TravelSpeed) * dt
    local snapRad = snap or Config.SnapRadius
    if dist <= snapRad or dist <= maxStep then
        root.CFrame = goal
    else
        root.CFrame = CFrame.new(cur + delta.Unit * maxStep) * (goal - goal.Position)
    end
    root.AssemblyLinearVelocity  = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local travelToken = 0
local function cancelTravel()
    travelToken += 1
end

local function travelTo(goalCF)
    travelToken += 1
    local my = travelToken
    local _, _, root0 = getCharacterParts()
    if not root0 then return false end

    local timeout = (goalCF.Position - root0.Position).Magnitude / math.max(Config.TravelSpeed, 1) + 5
    local t0      = os.clock()
    local arrived = false
    State.NeedNoclip = true

    while Runtime.Alive and travelToken == my and os.clock() - t0 < timeout do
        local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
        local _, _, root = getCharacterParts()
        if not root then break end
        stepToward(root, goalCF, dt)
        if (goalCF.Position - root.Position).Magnitude < 0.5 then
            arrived = true
            break
        end
    end

    if travelToken == my then
        State.NeedNoclip = false
    end
    return arrived
end

keep(RunService.Stepped:Connect(guarded("noclip", function()
    local char = LP.Character
    if State.NeedNoclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                noclipTouched[p] = true
                p.CanCollide = false
            end
        end
    elseif next(noclipTouched) ~= nil then
        for p in pairs(noclipTouched) do
            if p.Parent then p.CanCollide = true end
        end
        table.clear(noclipTouched)
    end
end)))

local function stopFarm(reason, restore)
    State.Enabled    = false
    State.Target     = nil
    State.EmptySince = nil

    local saved = State.SavedCFrame
    State.SavedCFrame = nil

    if restore and saved and getCharacterParts() then
        task.spawn(guarded("restore", function()
            Hooks.Status("Voltando à posição original...")
            travelTo(saved)
            if not State.Enabled and not State.QuestBusy then
                Hooks.Status("Parado")
            end
        end))
    else
        State.NeedNoclip = false
    end

    Hooks.FarmToggle(false)
    Hooks.Status("Parado")
    if reason == "no-npcs" then
        Hooks.Notify("Sem NPCs do grupo; voltando à posição original.")
    end
end

local function startFarm(originCF)
    if State.Enabled then return true end
    if not isRaidFarmActive() and not Config.NPCName then
        Hooks.Notify("Selecione um NPC primeiro.")
        Hooks.FarmToggle(false)
        return false
    end
    local _, _, root = getCharacterParts()
    if not root then
        Hooks.Notify("Personagem indisponível.")
        Hooks.FarmToggle(false)
        return false
    end
    cancelTravel()
    State.SavedCFrame = originCF or root.CFrame
    State.Target      = nil
    State.EmptySince  = nil
    State.Enabled     = true
    Hooks.FarmToggle(true)
    return true
end


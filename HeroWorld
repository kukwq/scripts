        if p and p:IsA("BasePart") then return p end
    end
    return nil
end

local function npcRootPart(npc)
    return firstBasePart(npc, {"HumanoidRootPart", "UpperTorso", "Torso", "Head"})
end

local function nearestQuestNPC(maxDist)
    local _, _, root = getCharacterParts()
    if not root then return nil end
    local best, bestDist = nil, maxDist
    for _, npc in ipairs(NPCS:GetChildren()) do
        local head  = npc:FindFirstChild("Head")
        local qmark = head and head:FindFirstChild("QMark")
        if qmark and qmark:IsA("BillboardGui") then
            local part = npcRootPart(npc)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d <= bestDist then best, bestDist = npc, d end
            end
        end
    end
    return best
end

local function round2(x)
    return math.floor(x * 100 + 0.5) / 100
end

local function learnStand(npc)
    local _, _, root = getCharacterParts()
    local part = npcRootPart(npc)
    if not root or not part then return end
    local off = root.Position - part.Position
    if off.Magnitude > 20 then return end
    local nx, ny, nz = round2(off.X), round2(off.Y), round2(off.Z)
    local cur = Config.QuestStand[npc.Name]
    if cur and math.abs(cur[1] - nx) < 0.5 and math.abs(cur[2] - ny) < 0.5 and math.abs(cur[3] - nz) < 0.5 then
        return
    end
    Config.QuestStand[npc.Name] = {nx, ny, nz}
    markDirty()
    Hooks.Notify(("Posição de pegada aprendida para %s (%.1f studs do NPC)"):format(npc.Name, off.Magnitude))
end


local function parseQuestDescription(raw)
    if type(raw) ~= "string" then return nil end
    local s = raw:gsub("<[^>]->", "")
    s = s:gsub("%[[%d%s/]+%]", "")
    s = s:gsub("%(%s*%d+%s*/%s*%d+%s*%)", "")
    s = s:gsub("^%s*[Dd][Ee][Ff][Ee][Aa][Tt]%s*", "")
    s = s:gsub("^%(?%s*%d+%s*%)?%s*[xX]?%s*", "")
    s = s:gsub("%s*%d+%s*/%s*%d+%s*$", "")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    local inner = s:match("^%((.+)%)$")
    if inner then s = inner:gsub("^%s+", ""):gsub("%s+$", "") end
    if s == "" then return nil end
    return s
end


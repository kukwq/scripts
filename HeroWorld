local function approachQuestNPC(npc)
    local touchPart = getQuestTouchPart(npc)
    if not touchPart then
        return false, "NPC de quest sem part alcançável"
    end

    Hooks.Status("Indo para dentro da part do NPC de quest...")
    local goalCF = CFrame.new(touchPart.Position)
    if not travelTo(goalCF) then
        return false, "não consegui chegar no NPC de quest"
    end

    local _, _, root = getCharacterParts()
    if root then
        root.CFrame = goalCF
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if typeof(firetouchinterest) == "function" then
            pcall(function()
                firetouchinterest(root, touchPart, 0)
                task.wait()
                firetouchinterest(root, touchPart, 1)
            end)
        end
    end
    return true
end

local function interactWithNPC(npc)
    for _, d in ipairs(npc:GetDescendants()) do
        if d:IsA("ProximityPrompt") and typeof(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, d)
            return
        elseif d:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
            pcall(fireclickdetector, d)
            return
        end
    end
    simulateClick()
end

local function clickGuiRect(obj)
